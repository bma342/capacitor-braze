{
  "name": "capacitor-braze",
  "version": "0.0.9",
  "description": "Capacitor 6+ plugin wrapping the official Braze SDKs for Android, iOS, and Web.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "android/consumer-rules.pro",
    "dist/",
    "ios/Plugin/",
    "BrazePlugin.podspec"
  ],
  "author": "Bryce Aspinwall <bryce.aspinwall@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bma342/capacitor-braze.git"
  },
  "bugs": {
    "url": "https://github.com/bma342/capacitor-braze/issues"
  },
  "homepage": "https://github.com/bma342/capacitor-braze#readme",
  "keywords": [
    "capacitor",
    "plugin",
    "braze",
    "appboy",
    "customer-engagement",
    "push-notifications",
    "in-app-messages",
    "analytics",
    "ios",
    "android",
    "web"
  ],
  "scripts": {
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rimraf": "^6.1.3",
    "rollup": "^4.13.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.3.4",
    "@braze/web-sdk": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@braze/web-sdk": {
      "optional": false
    }
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
