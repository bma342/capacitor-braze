{
  "name": "capacitor-braze",
  "version": "0.3.0",
  "description": "Unofficial, community-maintained Capacitor 6/7/8 plugin wrapping the official Braze SDKs for Android, iOS, and Web. Not affiliated with or endorsed by Braze, Inc.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "dist/",
    "ios/Sources/",
    "Package.swift",
    "CapacitorBraze.podspec",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "author": "Bryce Aspinwall <bryce.aspinwall@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bma342/capacitor-braze.git"
  },
  "bugs": {
    "url": "https://github.com/bma342/capacitor-braze/issues"
  },
  "homepage": "https://github.com/bma342/capacitor-braze#readme",
  "keywords": [
    "capacitor",
    "plugin",
    "braze",
    "appboy",
    "customer-engagement",
    "push-notifications",
    "in-app-messages",
    "analytics",
    "ios",
    "android",
    "web"
  ],
  "scripts": {
    "verify": "npm run verify:web",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint . --max-warnings=0",
    "prettier": "prettier \"**/*.{css,html,ts,js}\"",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api BrazePlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs && npm run docgen",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "test": "cd test/web && npm test",
    "test:watch": "cd test/web && npm run test:watch",
    "typecheck:tests": "cd test/mock-server && npx tsc --noEmit -p tsconfig.json && cd ../web && npx tsc --noEmit -p tsconfig.json",
    "pack:check": "node .github/scripts/assert-pack.mjs",
    "smoke:web": "bash scripts/smoke-web.sh",
    "smoke:ios": "bash scripts/smoke-ios.sh",
    "smoke:android": "bash scripts/smoke-android.sh",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@braze/web-sdk": "^6.13.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.5.2",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.4",
    "swiftlint": "^2.0.0",
    "typescript": "~5.4.2"
  },
  "peerDependencies": {
    "@braze/web-sdk": "^6.13.0",
    "@capacitor/core": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@braze/web-sdk": {
      "optional": false
    }
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
