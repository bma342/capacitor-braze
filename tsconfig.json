{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "module": "esnext",
    // TypeScript 5.6+ deprecated the implicit `node` value of
    // moduleResolution (it now maps to "node10" and prints TS5107).
    // "bundler" is the recommended successor for library code that
    // ships ESM + CJS via Rollup — it matches our Rollup config's
    // resolution behavior and stays forward-compatible into TS 7.
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "outDir": "./dist/esm",
    // TS 5.6+ requires rootDir to be explicit whenever outDir is set
    // (otherwise emits TS5011). Setting it to ./src locks the output
    // tree's structure to mirror the source tree.
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "strict": true,
    "target": "es2017",
    "lib": ["dom", "es2017"],
    // The plugin source targets the browser/WebView only. Pinning `types` to the
    // empty set stops any transitively installed @types/* (e.g. @types/node via
    // @capacitor/docgen) from leaking Node globals into the public surface or
    // breaking the build when a future @types major needs newer lib types.
    "types": []
  },
  "files": ["src/index.ts"],
  "include": ["src/**/*.ts"]
}
