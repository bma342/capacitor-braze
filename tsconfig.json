{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "outDir": "./dist/esm",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "strict": true,
    "target": "es2017",
    "lib": ["dom", "es2017"]
  },
  "files": ["src/index.ts"],
  "include": ["src/**/*.ts"]
}
