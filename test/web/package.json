{
  "name": "capacitor-braze-web-tests",
  "private": true,
  "version": "0.0.1",
  "description": "Behavioral tests for the plugin's web bridge against @braze/web-sdk, captured by an in-process mock Braze endpoint. Runs in jsdom under vitest.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@braze/web-sdk": "^7.1.0",
    "@capacitor/core": "^8.6.2",
    "capacitor-braze": "file:../..",
    "capacitor-braze-mock-server": "file:../mock-server"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  }
}
