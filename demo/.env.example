# Copy to `.env.local` and fill in your Braze trial / dev keys.
# Never commit `.env.local`.
#
# Both values come from your Braze dashboard:
#   - API key: Settings > APIs and Identifiers > SDK API Keys (the public one)
#   - Endpoint: shown on the same page (e.g. sdk.iad-03.braze.com)

VITE_BRAZE_API_KEY=
VITE_BRAZE_ENDPOINT=
